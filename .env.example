# --- Database (local docker, or your Supabase pooler URL) ---
DATABASE_URL=postgresql+asyncpg://engine:engine@localhost:5455/engine

# --- OpenRouter ---
FV_OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://firstvoid.com
OPENROUTER_APP_TITLE=FirstVoid Engine

# --- Security ---
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
ADMIN_API_KEY=change-me-in-production

# --- Runtime ---
ENV=dev
LOG_LEVEL=info
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
MAX_GRAPH_ITERATIONS=6

# --- Backups: any S3-compatible store (MinIO locally, Oracle/R2/S3 in prod) ---
# local MinIO:  docker compose --profile storage up -d minio
BACKUP_ENDPOINT_URL=http://localhost:9000
BACKUP_BUCKET=firstvoid-engine-backups
BACKUP_REGION=us-east-1
BACKUP_ACCESS_KEY=engineadmin
BACKUP_SECRET_KEY=enginesecret
BACKUP_RETAIN_DAYS=30

# --- Optional: Langfuse (self-hosted) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001
