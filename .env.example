# =============================================================================
#  bots-infra-be — environment
#  Copy to .env and fill in. .env is gitignored and must never be committed.
#      cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
#  REQUIRED
# -----------------------------------------------------------------------------

# Postgres with the pgvector extension.
# Local docker compose uses port 5455; a hosted Supabase URL works unchanged.
DATABASE_URL=postgresql+asyncpg://engine:engine@localhost:5455/engine

# Model gateway. Deliberately NOT named OPENROUTER_API_KEY: a bare name like that
# is commonly exported in a shell profile, and this project would then silently
# inherit and spend whatever key happened to be in the environment.
FV_OPENROUTER_API_KEY=

# Encrypts per-tenant integration credentials at rest (Fernet).
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating this makes every stored credential unreadable - they must be re-entered.
CREDENTIAL_ENCRYPTION_KEY=

# Guards every /v1/admin route. Change before anything is reachable from the internet.
ADMIN_API_KEY=change-me-in-production

# -----------------------------------------------------------------------------
#  RUNTIME
# -----------------------------------------------------------------------------

# dev | test | production. Tools are MOCKED in dev and test, so nothing reaches a
# real calendar, inbox or phone.
ENV=dev
LOG_LEVEL=info

# Hard switch, independent of ENV. Set true for any bulk replay: an eval running in
# a production environment would otherwise book real appointments for real people.
FORCE_MOCK_TOOLS=false

# Local ONNX embeddings - no PyTorch, no per-token cost. Changing the model means
# re-embedding every tenant, since the dimension is fixed at table creation.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Ceiling on agent<->tool loops in a single turn.
MAX_GRAPH_ITERATIONS=6

# The public URL this service is reached on. Required for Twilio webhooks: the
# signature covers the URL, and behind a proxy the app cannot derive it. A forwarded
# header is attacker-influenced, so this is configuration rather than inference.
PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
#  OPENROUTER (defaults are fine)
# -----------------------------------------------------------------------------
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=https://firstvoid.com
OPENROUTER_APP_TITLE=FirstVoid Engine

# -----------------------------------------------------------------------------
#  EMAIL (optional — unset means the dev sink: metadata logged, nothing sent)
# -----------------------------------------------------------------------------
# Platform-level, not per tenant: the agency sends for many clients from one
# verified domain. A tenant may override the reply-to so replies reach them.
RESEND_API_KEY=
EMAIL_FROM=FirstVoid Assistant <assistant@firstvoid.com>

# -----------------------------------------------------------------------------
#  BACKUPS (optional) — any S3-compatible store
#  Local MinIO:  docker compose --profile storage up -d minio
#  Production:   AWS S3, Oracle Object Storage, Cloudflare R2, Backblaze B2
#  Only the endpoint changes; boto3 speaks to all of them.
# -----------------------------------------------------------------------------
BACKUP_ENDPOINT_URL=http://localhost:9000
BACKUP_BUCKET=firstvoid-engine-backups
BACKUP_REGION=us-east-1
BACKUP_ACCESS_KEY=engineadmin
BACKUP_SECRET_KEY=enginesecret
BACKUP_RETAIN_DAYS=30
